// 모양 규칙(줄 길이, 표 정렬, 빈 줄 개수 등)은 모두 끄고, 렌더링이 깨지거나 링크·표가 망가지는 것만 잡는다.
// 규칙 목록은 ops/dev0/.markdownlint-cli2.jsonc 와 같다.
{
  "config": {
    "default": false,
    "MD001": true, // 제목 단계를 건너뜀 (# 다음에 ###)
    "MD011": true, // 링크 문법이 뒤집힘 (text)[url]
    "MD018": true, // # 뒤에 공백이 없어 제목이 안 됨
    "MD019": true, // # 뒤에 공백이 여러 개
    "MD025": true, // 한 파일에 최상위 제목이 여러 개
    "MD031": true, // 코드 블록 앞뒤에 빈 줄이 없음
    "MD037": true, // 강조 표시 안쪽에 공백이 있어 강조가 안 됨
    "MD038": true, // 코드 표시 안쪽에 공백
    "MD039": true, // 링크 글자 안쪽에 공백
    "MD040": true, // 코드 블록에 언어가 없음
    "MD042": true, // 빈 링크
    "MD045": true, // 이미지에 대체 글자가 없음
    "MD051": true, // 같은 파일 안의 #앵커 링크가 깨짐
    "MD052": true, // 정의되지 않은 참조 링크
    "MD053": true, // 쓰이지 않는 참조 링크 정의
    "MD056": true, // 표의 행마다 칸 수가 다름
    "MD058": true  // 표 앞뒤에 빈 줄이 없음
  },
  // 서브모듈은 각자 자기 설정으로 검사한다. 여기서는 보지 않는다.
  "ignores": [
    "ops/**",
    "projects/**"
  ],
  "noBanner": true,
  "noProgress": true
}
